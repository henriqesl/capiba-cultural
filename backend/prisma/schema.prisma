generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

  datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")

  }

  enum CategoriaEvento {
    ROCK
    SAMBA
    FREVO
    ARTE_VISUAL
    TEATRO
    GASTRONOMIA
    OUTRO
  }

  enum TipoMissao {
      COUNT_CHECKINS
      UNIQUE_LOCATIONS
      SPECIFIC_TAG
  }


  model Usuario {
    id               Int       @id      @default(autoincrement())
    cpf              String    @unique  @db.VarChar(11)
    nome             String
    email            String             @unique // um valor único, ou seja só podera existir 1 na tabela
    senha            String             // senha que será encripitada com jwt (explicar dps)
    saldoMoedaCapiba Int                @default(0) // o valor padrão é 0 (inicial)
    dataCadastro     DateTime           @default(now()) // o padrão é a data atual
    telefone         String             @default("00000000000") 
    username         String             @unique @default("temp_user")
    dataNascimento   DateTime           @default("2000-01-01T00:00:00Z")       
    imagemUrl        String?   



    // Relações (O que este usuário possui?)
    grupos_membro    GrupoCompeticao[]  @relation("MembrosDoGrupo") // um item da tabela GrupoCompeticao pode ter vários usuários nela
    grupos_vencidos  GrupoCompeticao[]  @relation("VencedorDoGrupo") 
    caravanas_membro Caravana[]         @relation("MembrosDaCaravana") // Modelo de Caravana
    
    // Histórico de Check-ins do usuário
    checkins         CheckIn[]
    eventos_participados Evento[]      @relation("ParticipantesDoEvento")
    reportes_feitos        ReporteEvento[] @relation("ReportesFeitos")
    reportes_confirmados   ReporteEvento[] @relation("ConfirmadoresDoReporte")
    status_progresso        StatusUsuario[] 

    @@map("usuarios")
  }


  model Evento {
    id                        Int                   @id @default(autoincrement())
    nome                      String  
    local                     String
    data                      DateTime
    descricao                 String
    categoria                 CategoriaEvento       @default(OUTRO)
    ativo                     Boolean               @default(true)
    aoVivo                    Boolean               @default(false)
    pequenoPorte              Boolean               @default(true)
    moedasCapibasDestribuidas  Float                @default(0)
    reportadoPorUsuario       Boolean               @default(false)
    confirmacoes              Int                   @default(0)
    preco                     String? 
    faixaEtaria               Int                   @default(0)
    precisaInscricao          Boolean               @default(false)
    imagemUrl                 String?   
    horario                   String?
    latitude                  Float    
    longitude                 Float
    

    checkins           CheckIn[] 
    participantes Usuario[]   @relation("ParticipantesDoEvento")
    caravanas     Caravana[]  @relation("CaravanasNoEvento")
    reportes ReporteEvento[] @relation("ReportesDoEvento")

    @@map("eventos")
  }


  model Missao {
    id                  Int           @id @default(autoincrement())
    titulo              String        @unique
    descricao           String
    recompensaCapibas   Int
    
    tipoRequisito       TipoMissao 
    valorRequisito      Int 
    tagRequisito        String?      // Usado para SPECIFIC_TAG (ex: "ROCK")

    // Relação com o progresso do usuário
    progressos          StatusUsuario[]

    @@map("missoes")
  }

  model StatusUsuario {
      id                  Int           @id @default(autoincrement()) 
      
      progressoAtual      Int           @default(0)
      concluida           Boolean       @default(false)
      dataConclusao       DateTime?

      // Relações
      usuario             Usuario       @relation(fields: [usuarioId], references: [id])
      usuarioId           Int
      
      missao              Missao        @relation(fields: [missaoId], references: [id])
      missaoId            Int

      @@unique([usuarioId, missaoId]) // Um usuário só pode ter um progresso por missão
      
      @@map("status_usuario")
  }


  model GrupoCompeticao {
    id             Int       @id @default(autoincrement())
    nome           String
    dataInicio     DateTime
    dataFim        DateTime
    encerrado      Boolean   @default(false)
    pontuacaoTotal Int       @default(0)

    membros        Usuario[] @relation("MembrosDoGrupo")

    vencedorId     Int?
    vencedor       Usuario?  @relation("VencedorDoGrupo", fields: [vencedorId], references: [id])

    @@map("grupos_competicao")
  }


  model Caravana {
    id                    Int       @id @default(autoincrement())
    nome                  String
    descricao             String    @default("Caravana sem descrição")
    ativo                 Boolean   @default(true)
    bonusPorParticipante  Int       @default(10)
    codigoAcesso          String    @unique

    eventoId              Int?
    evento                Evento?   @relation("CaravanasNoEvento", fields: [eventoId], references: [id])
    membros               Usuario[] @relation("MembrosDaCaravana")

    @@map("caravanas")
  }



  // Controle de presença e fraudes
  model CheckIn {
    id        Int      @id @default(autoincrement())
    data      DateTime @default(now()) // Data exata que leu o QR Code

    // Quem fez?
    usuario   Usuario @relation(fields: [usuarioId], references: [id])
    usuarioId Int

    // Em qual evento?
    evento    Evento  @relation(fields: [eventoId], references: [id])
    eventoId  Int


    // impede que o mesmo usuário (usuarioId) faça check-in no mesmo evento (eventoId) mais de uma vez.
    @@unique([usuarioId, eventoId]) 
    
    @@map("checkins")
  }

  model ReporteEvento {
    id              Int       @id @default(autoincrement())
    descricao       String?
    dataReporte     DateTime  @default(now())
    qtdConfirmacoes Int       @default(1)

    eventoId        Int
    evento          Evento    @relation("ReportesDoEvento", fields: [eventoId], references: [id])

    reportanteId    Int
    reportante      Usuario   @relation("ReportesFeitos", fields: [reportanteId], references: [id])

    confirmadores   Usuario[] @relation("ConfirmadoresDoReporte")

    @@map("reportes_eventos")
  }