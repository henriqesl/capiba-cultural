generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  nome             String
  email            String             @unique
  senha            String
  saldoMoedaCapiba Int                @default(0)
  dataCadastro     DateTime           @default(now())

  // Relações
  grupos_membro          MembroGrupo[] 
  caravanas_membro       MembroCaravana[]       
  eventos_participados   ParticipanteEvento[]
  grupos_vencidos        GrupoCompeticao[] @relation("VencedorDoGrupo")

  @@map("usuarios")
}

model Evento {
  id                        String    @id @default(auto()) @map("_id") @db.ObjectId 
  nome                      String
  local                     String
  data                      DateTime
  descricao                 String
  ativo                     Boolean   @default(true)
  aoVivo                    Boolean   @default(false)
  pequenoPorte              Boolean   @default(true)
  moedasCapibasDestribuidas Float     @default(0)
  reportadoPorUsuario       Boolean   @default(false)
  confirmacoes              Int       @default(0)

  participantes   ParticipanteEvento[]
  caravanas       Caravana[] @relation("CaravanasNoEvento")

  @@map("eventos")
}

model GrupoCompeticao {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId 
  nome           String
  dataInicio     DateTime
  dataFim        DateTime
  encerrado      Boolean    @default(false)
  pontuacaoTotal Int        @default(0)

  // Relações
  membros        MembroGrupo[] @relation("MembrosDoGrupo")

  vencedorId     String?       @db.ObjectId
  vencedor       Usuario?      @relation("VencedorDoGrupo", fields: [vencedorId], references: [id])

  @@map("grupos_competicao")
}

model Caravana {
  id                    String       @id @default(auto()) @map("_id") @db.ObjectId 
  nome                  String
  descricao             String
  ativo                 Boolean       @default(true)
  bonusPorParticipante  Int           @default(10)

  eventoId              String        @db.ObjectId
  evento                Evento        @relation("CaravanasNoEvento", fields: [eventoId], references: [id])
  membros               MembroCaravana[]

  @@map("caravanas")
} 

model MembroGrupo {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId   String            @db.ObjectId
  grupoId     String            @db.ObjectId

  usuario     Usuario           @relation(fields: [usuarioId], references: [id])
  grupo       GrupoCompeticao   @relation("MembrosDoGrupo", fields: [grupoId], references: [id])

  @@map("membros_grupo")
}

model MembroCaravana {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId   String          @db.ObjectId
  caravanaId  String          @db.ObjectId

  usuario     Usuario         @relation(fields: [usuarioId], references: [id])
  caravana    Caravana        @relation(fields: [caravanaId], references: [id])

  @@map("membros_caravana")
}

model ParticipanteEvento {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId   String        @db.ObjectId
  eventoId    String        @db.ObjectId

  usuario     Usuario       @relation(fields: [usuarioId], references: [id])
  evento      Evento        @relation(fields: [eventoId], references: [id])

  @@map("participantes_evento")
}
